        </mxCell>
        <mxCell id="pEEubyG2EgXKSioOIYiT-80" edge="1" parent="1" source="pEEubyG2EgXKSioOIYiT-49" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;defaultLabelBackgroundColor=page;" target="pEEubyG2EgXKSioOIYiT-77">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pEEubyG2EgXKSioOIYiT-49" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fillColor=#f5f5f5;strokeColor=#666666;align=center;fontColor=#333333;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;NOTE&lt;/h1&gt;&lt;p&gt;Open Library can return the list of contributors alongside the name of the main author in the &quot;author_name&quot; field, in these cases our LLM must identify which is which and take it into account for ranking candidates and explaining ordering of the results&lt;/p&gt;" vertex="1">
          <mxGeometry height="200" width="200" x="1360" y="200" as="geometry" />
        </mxCell>
        <mxCell id="pEEubyG2EgXKSioOIYiT-50" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;DILEMMA&lt;/h1&gt;&lt;p&gt;LLM is called twice, once to build the request with the identified intent, and again to rank the Open Library results, in the long run this could prove to be more expensive than issuing multiple requests to the data source (depending on the data source), a cost analysis per case is required.&amp;nbsp;&lt;/p&gt;&lt;p&gt;In hierarchy tiers 1, 2 and 4 the second LLM call is not necessary.&lt;/p&gt;" vertex="1">
          <mxGeometry height="240" width="200" x="1360" y="720" as="geometry" />
        </mxCell>
        <mxCell id="pEEubyG2EgXKSioOIYiT-56" edge="1" parent="1" source="pEEubyG2EgXKSioOIYiT-53" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;defaultLabelBackgroundColor=page;" target="pEEubyG2EgXKSioOIYiT-9" value="No">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pEEubyG2EgXKSioOIYiT-58" edge="1" parent="1" source="pEEubyG2EgXKSioOIYiT-53" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;defaultLabelBackgroundColor=page;" target="pEEubyG2EgXKSioOIYiT-57" value="Yes">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pEEubyG2EgXKSioOIYiT-53" parent="1" style="rhombus;whiteSpace=wrap;html=1;shapeInside=1;" value="The sole intent of the user&#39;s input was an Author&#39;s name?" vertex="1">
          <mxGeometry height="120" width="120" x="638" y="490" as="geometry" />
        </mxCell>
