        <mxCell id="pEEubyG2EgXKSioOIYiT-47" parent="1" style="ellipse;whiteSpace=wrap;html=1;shapeInside=1;aspect=fixed;fillColor=#ffe6cc;strokeColor=#d79b00;" value="END" vertex="1">
