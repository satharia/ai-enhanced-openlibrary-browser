# Copy to .env.local (git-ignored) and adjust.

# Base URL of the BookSearch API. In `npm run dev` the Vite proxy forwards /api to it, so the
# browser never needs CORS; in a production build the app calls this URL directly.
VITE_API_BASE_URL=http://localhost:5138

# PrimeUI license key for PrimeVue 5. Leave empty while evaluating; PrimeVue then shows a small
# "Invalid PrimeUI License" badge in the corner.
VITE_PRIMEUI_LICENSE=
